From 256873d25e31a49863234a5bd024db6bafd79a2f Mon Sep 17 00:00:00 2001
From: zeze89 <zz89842015@gmail.com>
Date: Thu, 19 Nov 2026 17:27:38 +0300
Subject: [PATCH] player: handle audio timestamp discontinuities without
 flushing video (r3)

- audio ts reset seen at the decoder is deferred until the jump reaches the
  filter output; then only the audio side is resynced (as on track switch).
  Video crosses its own discontinuity and its decoder is not flushed. With
  lookahead filters (dynaudnorm) the old immediate reset came seconds early,
  dropped audio and flushed the video decoder mid-GOP.
- 10 s safety net falls back to the old full reset.
- calculate_frame_duration: a jump >= the discontinuity tolerance of
  handle_new_frame() uses the nominal frame duration (WARN logged).
---
 player/audio.c | 42 ++++++++++++++++++++++++++++++++++++++++++
 player/core.h  |  5 +++++
 player/video.c | 20 ++++++++++++++++++++
 3 files changed, 67 insertions(+)

diff --git a/player/audio.c b/player/audio.c
index b3e975dd2e..6980a6e5cf 100644
--- a/player/audio.c
+++ b/player/audio.c
@@ -225,6 +225,7 @@ static void ao_chain_reset_state(struct ao_chain *ao_c)
     ao_c->untimed_throttle = false;
     ao_c->underrun = false;
     ao_c->delaying_audio_start = false;
+    ao_c->pts_reset_pending = false;
 }
 
 void reset_audio_state(struct MPContext *mpctx)
@@ -701,6 +702,28 @@ static void ao_process(struct mp_filter *f)
                 return;
             }
         }
+        // The timestamp discontinuity reported earlier by the decoder has
+        // reached the filter output, i.e. the audio before it has been sent
+        // to the AO. Resync only the audio side to video (like a track
+        // switch); video crosses its own discontinuity on its own and its
+        // decoder is not flushed.
+        if (ao_c->pts_reset_pending) {
+            double fpts = mp_aframe_get_pts(af);
+            if (fpts != MP_NOPTS_VALUE && ao_c->last_out_pts != MP_NOPTS_VALUE &&
+                fabs(fpts - ao_c->last_out_pts) >= 5)
+            {
+                MP_WARN(mpctx, "Audio timestamp discontinuity reached the "
+                        "output (%f -> %f), resyncing audio to video.\n",
+                        ao_c->last_out_pts, fpts);
+                mp_pin_out_unread(f->ppins[0], frame);
+                if (mpctx->ao)
+                    ao_reset(mpctx->ao);
+                reset_audio_state(mpctx);
+                mp_wakeup_core(mpctx);
+                return;
+            }
+        }
+
         double startpts = mpctx->audio_status == STATUS_SYNCING ?
                                             ao_c->start_pts : MP_NOPTS_VALUE;
         mp_aframe_clip_timestamps(af, startpts, endpts);
@@ -892,7 +915,26 @@ void fill_audio_out_buffers(struct MPContext *mpctx)
     if (mpctx->vo_chain && ao_c->track && ao_c->track->dec &&
         mp_decoder_wrapper_get_pts_reset(ao_c->track->dec))
     {
+        // Audio filters with lookahead (dynaudnorm, loudnorm) hold seconds
+        // of audio, so the decoder sees the jump long before it is played.
+        // Resetting playback now would drop that audio and flush the video
+        // decoder in the middle of a GOP, while video is still seconds
+        // before its own discontinuity. Wait until the jump reaches the
+        // filter output instead (handled in ao_process()).
+        if (!ao_c->pts_reset_pending) {
+            MP_WARN(mpctx, "Audio timestamp reset at the decoder, deferring "
+                    "until it reaches the output.\n");
+            ao_c->pts_reset_pending = true;
+            ao_c->pts_reset_time = mp_time_sec();
+        }
+        mp_wakeup_core(mpctx);
+    }
+
+    // Safety net: the jump never showed up at the output (e.g. a filter
+    // rewrote timestamps). Fall back to the old behavior.
+    if (ao_c->pts_reset_pending && mp_time_sec() - ao_c->pts_reset_time > 10) {
         MP_WARN(mpctx, "Reset playback due to audio timestamp reset.\n");
+        ao_c->pts_reset_pending = false;
         reset_playback_state(mpctx);
         mp_wakeup_core(mpctx);
     }
diff --git a/player/core.h b/player/core.h
index eb7f508cab..0b239ee64b 100644
--- a/player/core.h
+++ b/player/core.h
@@ -194,6 +194,11 @@ struct ao_chain {
     bool out_eof;
     double last_out_pts;
 
+    // Audio timestamp discontinuity seen by the decoder, not yet at the
+    // filter output (see fill_audio_out_buffers()).
+    bool pts_reset_pending;
+    double pts_reset_time;
+
     double start_pts;
     bool start_pts_known;
 
diff --git a/player/video.c b/player/video.c
index 0e1ac290d2..dd40f73d3c 100644
--- a/player/video.c
+++ b/player/video.c
@@ -981,6 +981,26 @@ static void calculate_frame_duration(struct MPContext *mpctx)
         double pts1 = mpctx->next_frames[1]->pts;
         if (pts0 != MP_NOPTS_VALUE && pts1 != MP_NOPTS_VALUE && pts1 >= pts0)
             duration = pts1 - pts0;
+
+        // A timestamp discontinuity (e.g. HLS EXT-X-DISCONTINUITY) between
+        // these two frames is not a frame duration. handle_new_frame() treats
+        // the same jump as a discontinuity; use the same tolerance here and
+        // fall back to the nominal duration. Otherwise the last frame before
+        // the jump is held for up to 10 seconds, display sync is disabled,
+        // and a VO reconfig for the next frame waits until it is "done".
+        bool is_sparse = vo_c->is_sparse;
+        double tolerance = mpctx->demuxer->ts_resets_possible &&
+                           !is_sparse ? 5 : 1e4;
+        if (duration >= tolerance) {
+            double nominal = demux_duration;
+            if (nominal <= 0 && mpctx->num_past_frames > 1 &&
+                mpctx->past_frames[1].duration > 0 &&
+                mpctx->past_frames[1].duration < tolerance)
+                nominal = mpctx->past_frames[1].duration;
+            MP_WARN(mpctx, "Timestamp discontinuity: %f -> %f, using frame "
+                       "duration %f\n", pts0, pts1, nominal);
+            duration = nominal;
+        }
     }
 
     // The following code tries to compensate for rounded Matroska timestamps
-- 
2.53.0.windows.3

